{
  "id": "agent-home",
  "version": "1.0.0",
  "name": "Agent Home (host bind mounts)",
  "description": "Bind-mount host Cursor, Claude Code, and shared agents config (skills/rules/MCP) into the container user home.",
  "documentationURL": "https://github.com/aj-foster/devcontainer-features/tree/main/src/agent-home",
  "keywords": [
    "cursor",
    "claude",
    "agents",
    "skills",
    "mcp"
  ],
  "mounts": [
    {
      "source": "${localEnv:HOME}${localEnv:USERPROFILE}/.cursor",
      "target": "/home/vscode/.cursor",
      "type": "bind"
    },
    {
      "source": "${localEnv:HOME}${localEnv:USERPROFILE}/.claude",
      "target": "/home/vscode/.claude",
      "type": "bind"
    },
    {
      "source": "${localEnv:HOME}${localEnv:USERPROFILE}/.claude.json",
      "target": "/home/vscode/.claude.json",
      "type": "bind"
    },
    {
      "source": "${localEnv:HOME}${localEnv:USERPROFILE}/.agents",
      "target": "/home/vscode/.agents",
      "type": "bind"
    }
  ]
}
